{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // scripts/ and tests/ are standalone dev tooling run outside the Next build.
  // Most of scripts/ targets the deleted Prisma database and is dead code;
  // see PRODUCTION_READINESS.md (P2-8). Excluded so they cannot break the
  // production build, but left on disk for review.
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "storybook-static",
    "scripts",
    "tests"
  ]
}

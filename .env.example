# =============================================================================
# Stupendous LMS — backend environment
#
# Copy to .env and fill in. Values marked REQUIRED have no safe default:
# settings.py raises ImproperlyConfigured at startup rather than falling back
# to something insecure. See PRODUCTION_READINESS.md (P0-8).
# =============================================================================

# --- Core -------------------------------------------------------------------

# REQUIRED in production. This key also signs JWTs, so anyone who knows it can
# forge a token for any user, including a superuser. Never reuse across
# environments, never commit. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Defaults to False. Only ever True on a local machine.
DEBUG=False

# REQUIRED in production — must include your real hostname(s).
ALLOWED_HOSTS=lms.5stars.dev

# --- Database ---------------------------------------------------------------

DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=<coolify-postgres-internal-hostname>
DB_PORT=5432

# Defaults to 'require' when DEBUG=False. Use 'prefer' only for local dev.
DB_SSL_MODE=require

# Seconds to keep a database connection open for reuse.
DB_CONN_MAX_AGE=60

# --- CORS / CSRF ------------------------------------------------------------

# The frontend origin(s) allowed to call this API.
CORS_ALLOWED_ORIGINS=https://learn.5stars.dev

# Origins trusted for CSRF. Must include the scheme.
CSRF_TRUSTED_ORIGINS=https://lms.5stars.dev,https://learn.5stars.dev

# --- Media storage ----------------------------------------------------------
#
# Container filesystems are ephemeral: with USE_S3_MEDIA=False, every uploaded
# avatar, thumbnail and lesson video is destroyed on redeploy and is not served
# at all when DEBUG=False. Set this to True in any deployed environment.
# See PRODUCTION_READINESS.md (P0-10).

USE_S3_MEDIA=True
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Set for S3-compatible providers (Cloudflare R2, Backblaze B2, MinIO).
# Leave blank for real AWS S3.
AWS_S3_ENDPOINT_URL=

# Public bucket/CDN domain used to build media URLs. Serving user uploads from
# a domain separate from the app limits the blast radius of a malicious upload.
AWS_S3_CUSTOM_DOMAIN=

# True = signed, expiring URLs (private bucket). False = public-read objects.
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=3600

# --- Cache / rate limiting --------------------------------------------------
#
# Throttle counters live in the cache. Without Redis each gunicorn worker keeps
# its own counters, so the effective rate limit is multiplied by worker count.
REDIS_URL=redis://redis:6379/0

# Rate limits (DRF syntax: "<number>/<period>").
THROTTLE_ANON=60/min
THROTTLE_USER=300/min
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_UPLOAD=30/hour

# --- Security headers -------------------------------------------------------
# Applied only when DEBUG=False.

SECURE_SSL_REDIRECT=True
# One year. Start lower (e.g. 3600) when first enabling HSTS — browsers honour
# the max-age even if you later disable HTTPS.
SECURE_HSTS_SECONDS=31536000

# --- Email ------------------------------------------------------------------
#
# SMTP credentials are configured in the Django admin under Site Settings,
# not here. This only bounds how long a request may block on a stalled SMTP
# server (email is sent synchronously inside the request cycle).
EMAIL_TIMEOUT=10

# --- Logging ----------------------------------------------------------------

LOG_LEVEL=INFO
# Containers should log to stdout and let the platform collect it.
LOG_TO_FILE=False

# --- Gunicorn ---------------------------------------------------------------

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# --- Demo data --------------------------------------------------------------
#
# NEVER set to true in production. Seeds accounts whose passwords are published
# in this repository. The seed scripts additionally refuse to run unless
# DEBUG=True. See PRODUCTION_READINESS.md (P0-6).
SEED_DEMO_DATA=false

# =============================================================================
# Frontend (frontend/.env.local, and a Coolify BUILD variable in production)
#
# NEXT_PUBLIC_* values are compiled into the browser bundle at BUILD time, not
# read at runtime. In Coolify this must be set as a *build* variable or the
# deployed bundle will point at localhost. See PRODUCTION_READINESS.md (P1-9).
# =============================================================================

NEXT_PUBLIC_API_URL=https://lms.5stars.dev

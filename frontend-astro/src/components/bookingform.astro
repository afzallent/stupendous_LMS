---
import Button from "./ui/button.astro";
const programsData = await import("../../public/data/programs.json");
const programs = Object.entries(programsData.default).map(([slug, data]) => ({
  slug,
  title: data.title
}));
---

<form
  id="bookingForm"
  class="needs-validation"
  novalidate>
  <input type="checkbox" class="hidden" style="display:none" name="botcheck" />
  <div class="mb-5">
    <input
      type="text"
      placeholder="Your Name"
      required
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
      name="name"
    />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Please provide your name.
    </div>
  </div>
  <div class="mb-5">
    <input
      type="email"
      placeholder="Email Address"
      required
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
      name="email"
    />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Please provide your email address.
    </div>
  </div>
  <div class="mb-5">
    <input
      type="tel"
      placeholder="Phone Number"
      required
      pattern="[0-9+ -]+"
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
      name="phone"
    />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Please provide your phone number.
    </div>
  </div>
  <div class="mb-5">
    <input
      type="text"
      placeholder="Institution Name"
      required
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
      name="institution"
    />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Please provide your institution name.
    </div>
  </div>
  <div class="mb-5">
    <label class="block text-sm font-medium text-gray-700 mb-1">Select Programs</label>
    <div class="space-y-2 max-h-60 overflow-y-auto border-2 p-3 rounded-md border-gray-300">
      {programs.map((program) => (
        <div class="flex items-center">
          <input
            type="checkbox"
            id={program.slug}
            name="programs"
            value={program.slug}
            class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
          />
          <label for={program.slug} class="ml-2 block text-sm text-gray-900">
            {program.title}
          </label>
        </div>
      ))}
    </div>
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Please select at least one program.
    </div>
  </div>
  <div class="mb-5">
    <select
      required
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
      name="participants">
      <option value="">Select expected participants</option>
      <option value="1-10">1-10 participants</option>
      <option value="11-25">11-25 participants</option>
      <option value="26-50">26-50 participants</option>
      <option value="50+">50+ participants</option>
    </select>
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Please select expected number of participants.
    </div>
  </div>
  <div class="mb-5">
    <select
      required
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
      name="mode">
      <option value="">Select training mode</option>
      <option value="online">Online</option>
      <option value="onsite">On-site</option>
      <option value="hybrid">Hybrid</option>
    </select>
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Please select a training mode.
    </div>
  </div>
  <div class="mb-5">
    <input
      type="date"
      required
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
      name="date"
    />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Please select a preferred date.
    </div>
  </div>
  <div class="mb-5">
    <textarea
      name="requirements"
      placeholder="Tell us about any specific training needs or requirements..."
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none h-36 focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
    ></textarea>
  </div>
  <Button type="submit" size="lg" block>Request Training Session</Button>
  <div id="result" class="mt-3 text-center"></div>
</form>

<!-- Toast Notification -->
<div id="toast" class="fixed bottom-4 right-4 px-6 py-4 rounded-lg transform transition-transform duration-300 translate-y-full">
  <p class="text-white"></p>
</div>

<style>
  .invalid-feedback,
  .empty-feedback {
    display: none;
  }

  .was-validated :placeholder-shown:invalid ~ .empty-feedback {
    display: block;
  }

  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
    display: block;
  }

  .is-invalid,
  .was-validated :invalid {
    border-color: #dc3545;
  }

  #toast {
    z-index: 1000;
    visibility: hidden;
  }

  #toast.show {
    visibility: visible;
    transform: translateY(0);
  }

  #toast.success {
    background-color: #10B981;
  }

  #toast.error {
    background-color: #EF4444;
  }
</style>

<script is:inline>
  const form = document.getElementById("bookingForm");
  const result = document.getElementById("result");
  const toast = document.getElementById("toast");

  function showToast(message, type) {
    const toastElement = toast;
    toastElement.querySelector("p").textContent = message;
    toastElement.classList.add("show", type);
    
    setTimeout(() => {
      toastElement.classList.remove("show", type);
    }, 5000);
  }

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    form.classList.add("was-validated");
    
    // Check if at least one program is selected
    const selectedPrograms = [...form.querySelectorAll('input[name="programs"]:checked')];
    if (selectedPrograms.length === 0) {
      form.querySelectorAll('input[name="programs"]')[0].focus();
      return;
    }
    
    if (!form.checkValidity()) {
      form.querySelectorAll(":invalid")[0].focus();
      return;
    }
    
    const formData = new FormData(form);
    const object = {
      formType: 'booking',
      name: formData.get('name'),
      email: formData.get('email'),
      phone: formData.get('phone'),
      institution: formData.get('institution'),
      program: selectedPrograms.map(input => input.value),
      participants: formData.get('participants'),
      trainingMode: formData.get('mode'),
      preferredDate: formData.get('date'),
      message: formData.get('requirements'),
      botcheck: formData.get('botcheck') // Include botcheck for server-side validation
    };
    const json = JSON.stringify(object);

    result.innerHTML = "Sending...";

    fetch("https://techinteach.com/admin_login/api/send_email.php", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Accept: "application/json",
      },
      body: json,
    })
      .then(async (response) => {
        const json = await response.json();
        if (response.ok) {
          showToast("Thank you! We'll respond to your request within 24-48 hours.", "success");
        } else {
          showToast(json.message || "Failed to send request. Please try again.", "error");
          console.error(json);
        }
      })
      .catch((error) => {
        console.error(error);
        showToast("Something went wrong. Please try again later.", "error");
      })
      .finally(() => {
        result.innerHTML = "";
        form.reset();
        form.classList.remove("was-validated");
      });
  });
</script>
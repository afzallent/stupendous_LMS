---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Container from '../../components/container.astro';
import { Icon } from 'astro-icon/components';
import { djangoApiServer, API_ENDPOINTS } from '../../utils/django-api-server';

// Get the ID from URL params
const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/404');
}

// Fetch course from Django API
let course = null;
let error = null;

try {
  const response = await djangoApiServer.get(API_ENDPOINTS.courses.detail(parseInt(id)));
  
  if (response.success) {
    course = response.data || response;
  } else {
    error = response.error;
  }
} catch (e) {
  console.error('Error fetching course:', e);
  error = 'Failed to load course';
}

// Handle case where course is not found
if (!course || error) {
  return Astro.redirect('/404');
}

// Format price
const formatPrice = (price) => {
  const numPrice = parseFloat(price);
  return numPrice === 0 ? 'Free' : `$${numPrice.toFixed(2)}`;
};
---

<Layout title={`${course.title} - Stupendous LMS`}>
  <Container>
    <div class="max-w-6xl mx-auto py-8 px-4 sm:px-6 lg:px-8">

      <!-- Page Header -->
      <div class="mb-8">
        <a href="/courses" class="text-blue-600 hover:text-blue-800 flex items-center mb-4">
          <Icon name="mdi:arrow-left" class="w-5 h-5 mr-2" />
          Back to Courses
        </a>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-800 mb-3">{course.title}</h1>
        <p class="text-xl text-gray-600">{course.description}</p>
        <p class="text-md text-gray-500 mt-2">
          Taught by: <span class="font-semibold text-blue-600">{course.instructor.username}</span>
        </p>
      </div>

      <!-- Main Content -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Left Column - Course Details -->
        <div class="lg:col-span-2 space-y-8">
          
          <!-- Course Preview -->
          <div class="bg-white rounded-lg shadow-xl overflow-hidden">
            <div class="aspect-w-16 aspect-h-9 bg-gray-200">
              {course.thumbnail ? (
                <img src={course.thumbnail} alt={course.title} class="w-full h-full object-cover" />
              ) : (
                <div class="flex items-center justify-center h-full">
                  <Icon name="mdi:play-circle-outline" class="w-24 h-24 text-gray-400" />
                </div>
              )}
            </div>
            <div class="p-6">
              <h2 class="text-2xl font-bold text-gray-800 mb-3">Course Preview</h2>
              <p class="text-gray-600">Explore {course.title} and start your learning journey.</p>
            </div>
          </div>

          <!-- About This Course -->
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h2 class="text-2xl font-semibold text-gray-800 mb-4">About This Course</h2>
            <div class="prose prose-lg max-w-none text-gray-700">
              <p>{course.description}</p>
            </div>
          </div>
          
          <!-- Course Content -->
          {course.lessons && course.lessons.length > 0 && (
            <div class="bg-white p-6 rounded-lg shadow-md">
              <h2 class="text-2xl font-semibold text-gray-800 mb-4">Course Content</h2>
              <div class="space-y-2">
                {course.lessons.map((lesson, index) => (
                  <div class="flex items-center p-3 border rounded-md hover:bg-gray-50">
                    <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center mr-3">
                      <span class="text-blue-600 font-semibold text-sm">{index + 1}</span>
                    </div>
                    <div class="flex-1">
                      <h3 class="font-medium text-gray-900">{lesson.title}</h3>
                    </div>
                    {lesson.video_url && (
                      <Icon name="mdi:play-circle" class="w-5 h-5 text-gray-400" />
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

        </div>
        
        <!-- Right Sidebar - Enrollment Card -->
        <aside class="lg:col-span-1">
          <div class="bg-white rounded-lg shadow-xl p-6 sticky top-8">
            {course.thumbnail && (
              <img src={course.thumbnail} alt={course.title} class="w-full h-auto rounded-md mb-4 object-cover max-h-60" />
            )}
            
            <div class="mb-4">
              <div class="text-4xl font-bold text-gray-900 mb-2">{formatPrice(course.price)}</div>
              {course.original_price && parseFloat(course.original_price) > parseFloat(course.price) && (
                <div class="text-lg text-gray-500 line-through">{formatPrice(course.original_price)}</div>
              )}
            </div>

            <!-- Enrollment Button (will be handled client-side) -->
            <div id="enrollment-section">
              <button 
                id="enrollBtn"
                data-course-id={course.id}
                data-course-price={course.price}
                data-is-free={course.is_free}
                class="w-full px-6 py-3 bg-blue-600 text-white font-semibold rounded-md hover:bg-blue-700 transition-colors duration-150 text-lg mb-4"
              >
                {course.is_free || parseFloat(course.price) === 0 ? 'Enroll for Free' : 'Buy Now'}
              </button>
            </div>
            
            <div class="space-y-3 text-sm text-gray-600">
              <div class="flex items-center">
                <Icon name="mdi:account-group-outline" class="w-5 h-5 mr-2 text-blue-500" />
                <span>{course.total_enrollments} students enrolled</span>
              </div>
              <div class="flex items-center">
                <Icon name="mdi:book-outline" class="w-5 h-5 mr-2 text-blue-500" />
                <span>{course.total_lessons} lessons</span>
              </div>
              <div class="flex items-center">
                <Icon name="mdi:clock-outline" class="w-5 h-5 mr-2 text-blue-500" />
                <span>Self-paced learning</span>
              </div>
              <div class="flex items-center">
                <Icon name="mdi:certificate-outline" class="w-5 h-5 mr-2 text-blue-500" />
                <span>Certificate of completion</span>
              </div>
              <div class="flex items-center">
                <Icon name="mdi:update" class="w-5 h-5 mr-2 text-blue-500" />
                <span>Lifetime access</span>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </Container>
</Layout>

<script>
  import { djangoApi, API_ENDPOINTS, TokenManager } from '../../config/django-api.config';
  
  const enrollBtn = document.getElementById('enrollBtn');
  const courseId = enrollBtn?.getAttribute('data-course-id');
  
  console.log('Enrollment script loaded');
  console.log('Course ID:', courseId);
  console.log('Enroll button:', enrollBtn);
  
  async function checkEnrollment() {
    if (!courseId) {
      console.error('No course ID found');
      return;
    }
    
    const user = TokenManager.getUser();
    console.log('Current user:', user);
    
    if (!user) {
      console.log('User not logged in, showing login button');
      enrollBtn.textContent = 'Login to Enroll';
      enrollBtn.onclick = () => window.location.href = '/login/student';
      return;
    }
    
    console.log('Checking enrollment status...');
    const response = await djangoApi.get(`${API_ENDPOINTS.enrollments.check}?courseId=${courseId}`);
    console.log('Enrollment check response:', response);
    
    if (response.success && response.is_enrolled) {
      console.log('User is already enrolled');
      enrollBtn.textContent = 'Continue Learning';
      enrollBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
      enrollBtn.classList.add('bg-green-600', 'hover:bg-green-700');
      enrollBtn.onclick = () => window.location.href = `/course-player?course_id=${courseId}`;
    } else {
      console.log('User not enrolled, setting up enroll handler');
      enrollBtn.onclick = handleEnroll;
    }
  }
  
  async function handleEnroll(e) {
    e.preventDefault();
    console.log('Enroll button clicked!');
    
    const user = TokenManager.getUser();
    if (!user) {
      console.log('User not logged in, redirecting to login');
      window.location.href = '/login/student';
      return;
    }
    
    // Check if course requires payment
    const coursePrice = parseFloat(enrollBtn.dataset.coursePrice || '0');
    const isFree = enrollBtn.dataset.isFree === 'true';
    
    console.log('Course price:', coursePrice, 'Is free:', isFree);
    
    if (!isFree && coursePrice > 0) {
      // Redirect to payment page
      console.log('Course requires payment, redirecting to checkout...');
      window.location.href = `/checkout?course_id=${courseId}`;
      return;
    }
    
    // Free course - proceed with enrollment
    console.log('Starting enrollment process for free course...');
    enrollBtn.disabled = true;
    enrollBtn.textContent = 'Enrolling...';
    
    const enrollData = {
      course_id: parseInt(courseId)
    };
    console.log('Enrollment data:', enrollData);
    console.log('API endpoint:', API_ENDPOINTS.enrollments.create);
    
    const response = await djangoApi.post(API_ENDPOINTS.enrollments.create, enrollData);
    console.log('Enrollment response:', response);
    
    if (response.success) {
      console.log('Enrollment successful!');
      enrollBtn.textContent = 'Continue Learning';
      enrollBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
      enrollBtn.classList.add('bg-green-600', 'hover:bg-green-700');
      enrollBtn.disabled = false;
      enrollBtn.onclick = () => window.location.href = `/course-player?course_id=${courseId}`;
      
      alert('Successfully enrolled in course!');
    } else {
      console.error('Enrollment failed:', response.error);
      enrollBtn.disabled = false;
      enrollBtn.textContent = 'Enroll Now';
      alert('Error: ' + (response.error || response.detail || 'Failed to enroll'));
    }
  }
  
  // Initialize
  if (enrollBtn) {
    console.log('Initializing enrollment check...');
    checkEnrollment();
  } else {
    console.error('Enroll button not found!');
  }
</script>

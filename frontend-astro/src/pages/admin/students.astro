---
import Layout from '../../layouts/Layout.astro';
const CLERK_SECRET_KEY = import.meta.env.CLERK_SECRET_KEY;
const CLERK_STUDENT_ROLE = import.meta.env.CLERK_STUDENT_ROLE ?? 'student'; // Default to 'student'

// Handle POST requests for actions
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const userId = formData.get('user_id');
  const action = formData.get('action');

  if (userId && action) {
    let url = `https://api.clerk.com/v1/users/${userId}`;
    let method = '';
    let body = null;

    if (action === 'delete') {
      method = 'DELETE';
    } else if (action === 'block') {
      url = `https://api.clerk.com/v1/users/${userId}/ban`;
      method = 'POST';
    } else if (action === 'unblock') {
      url = `https://api.clerk.com/v1/users/${userId}/unban`;
      method = 'POST';
    }

    if (method) {
      await fetch(url, {
        method: method,
        headers: {
          'Authorization': `Bearer ${CLERK_SECRET_KEY}`,
          'Content-Type': 'application/json',
        },
        body: body ? JSON.stringify(body) : null,
      });
      // Redirect to the same page to see the changes
      return Astro.redirect('/admin/students');
    }
  }
}


// Fetch students from Clerk
let students = [];
let debugError = '';
try {
  const response = await fetch('https://api.clerk.com/v1/users?limit=200', {
    headers: {
      'Authorization': `Bearer ${CLERK_SECRET_KEY}`,
    },
  });
  const data = await response.json();
  // Clerk API returns users directly as an array, not in a standardized wrapper
  if (Array.isArray(data)) {
    if (data.length) {
      students = data
        .filter(user => user.public_metadata?.role === CLERK_STUDENT_ROLE)
        .map(user => ({
          id: user.id,
          name: user.first_name || user.username || 'N/A',
          email: user.email_addresses?.[0]?.email_address || 'No email',
          enrolledCourses: user.public_metadata?.enrolled_courses?.length || 0,
          banned: user.banned,
          status: user.banned ? 'Banned' : 'Active',
        }));
    } else {
      debugError = 'No users found in Clerk.';
    }
  } else {
    // Handle error responses from Clerk
    debugError = data.errors?.[0]?.long_message || data.message || `Clerk API error: ${response.status} ${response.statusText}`;
  }
} catch (e) {
  debugError = 'Fetch error: ' + e.message;
}
export const prerender = false;
---

<Layout title="Manage Students">
  <main class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold">Manage Students</h1>
      <a href="/admin/add-student" class="bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded">
        Add New Student
      </a>
    </div>

    {debugError && <div class="mb-4 p-4 bg-red-100 border border-red-300 text-red-700 rounded">{debugError}</div>}

    <div class="bg-white shadow-md rounded-lg overflow-hidden">
      <table class="min-w-full leading-normal">
        <thead>
          <tr>
            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Name</th>
            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Email</th>
            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Status</th>
            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody>
          {students.length > 0 ? students.map(student => (
            <tr>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">{student.name}</td>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">{student.email}</td>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                <span class={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${ student.banned ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800' }`}>
                  {student.status}
                </span>
              </td>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                <div class="flex items-center space-x-2">
                  <a href={`/admin/add-student?id=${student.id}&edit=true`} class="text-blue-600 hover:text-blue-900">Edit</a>
                  
                  <form method="POST" style="display:inline" onsubmit="return confirm('Are you sure you want to delete this student? This is irreversible.');">
                    <input type="hidden" name="user_id" value={student.id} />
                    <input type="hidden" name="action" value="delete" />
                    <button type="submit" class="text-red-600 hover:text-red-900">Delete</button>
                  </form>

                  <form method="POST" style="display:inline">
                    <input type="hidden" name="user_id" value={student.id} />
                    {student.banned ? (
                      <>
                        <input type="hidden" name="action" value="unblock" />
                        <button type="submit" class="text-yellow-600 hover:text-yellow-900">Unblock</button>
                      </>
                    ) : (
                      <>
                        <input type="hidden" name="action" value="block" />
                        <button type="submit" class="text-yellow-600 hover:text-yellow-900" onsubmit="return confirm('Are you sure you want to block this student?');">Block</button>
                      </>
                    )}
                  </form>
                </div>
              </td>
            </tr>
          )) : (
            <tr>
              <td colspan="4" class="text-center py-10">No students found.</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </main>
</Layout> 
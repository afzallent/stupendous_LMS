---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { apiServer, API_ENDPOINTS } from '../../utils/api-server';

const url = new URL(Astro.request.url);
const studentId = url.searchParams.get('id');
const isEditMode = url.searchParams.get('edit') === 'true';

let success = false;
let generatedPassword = '';
let errorMessage = '';
let formDataPrefill = { name: '', email: '' };

if (isEditMode && studentId) {
  // Fetch student data from V2 API
  try {
    const response = await apiServer.get(`${API_ENDPOINTS.students}?id=${studentId}`);
    if (response.success && response.data) {
      formDataPrefill = {
        name: response.data.name || response.data.display_name || '',
        email: response.data.email || '',
      };
    }
  } catch (error) {
    console.error('Failed to fetch student data:', error);
  }
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const name = formData.get('name')?.toString() || '';
  const email = formData.get('email')?.toString() || '';

  try {
    if (isEditMode && studentId) {
      // Update existing student using V2 API
      const response = await apiServer.put(API_ENDPOINTS.students, {
        id: studentId,
        name: name,
        email: email
      });
      
      if (response.success) {
        success = true;
      } else {
        errorMessage = response.error || 'Failed to update student';
      }
    } else {
      // Create new student using V2 API
      const response = await apiServer.post(API_ENDPOINTS.students, {
        name: name,
        email: email
      });
      
      if (response.success && response.data) {
        success = true;
        generatedPassword = response.data.password || '';
      } else {
        errorMessage = response.error || 'Failed to create student';
      }
    }
  } catch (error) {
    console.error('API Error:', error);
    errorMessage = error instanceof Error ? error.message : 'An unexpected error occurred';
  }
}
---

<Layout title={isEditMode ? 'Edit Student' : 'Add New Student'}>
  <main class="container mx-auto px-4 py-8">
    {success ? (
      <div class="max-w-lg mx-auto bg-green-50 border border-green-200 rounded-lg p-8 text-center shadow">
        <h2 class="text-2xl font-bold text-green-700 mb-4">Student {isEditMode ? 'updated' : 'created'}!</h2>
        {isEditMode ? (
          <a href="/admin/students" class="inline-block mt-4 px-6 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 font-semibold">Back to Students</a>
        ) : (
          <>
            <p class="mb-2">Share this temporary password with the student:</p>
            <div class="mb-4">
              <span class="inline-block bg-gray-100 text-lg font-mono px-4 py-2 rounded border border-gray-300">{generatedPassword}</span>
            </div>
            <a href="/admin/students" class="inline-block mt-4 px-6 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 font-semibold">Back to Students</a>
          </>
        )}
      </div>
    ) : (
      <main class="container mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold mb-8">{isEditMode ? 'Edit Student' : 'Add New Student'}</h1>
        
        {errorMessage && (
          <div class="max-w-lg mx-auto bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
            <p class="text-red-700">{errorMessage}</p>
          </div>
        )}
        
        <form method="POST" class="bg-white shadow-md rounded-lg px-8 pt-6 pb-8 mb-4">
          <div class="mb-4">
            <label class="block text-gray-700 text-sm font-bold mb-2" for="name">
              Name
            </label>
            <input class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" id="name" name="name" type="text" placeholder="Student Name" value={formDataPrefill.name} required />
          </div>
          <div class="mb-4">
            <label class="block text-gray-700 text-sm font-bold mb-2" for="email">
              Email
            </label>
            <input class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" id="email" name="email" type="email" placeholder="Student Email" value={formDataPrefill.email} required />
          </div>
          <div class="flex items-center justify-between">
            <button class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" type="submit">
              {isEditMode ? 'Update Student' : 'Add Student'}
            </button>
            <a href="/admin/students" class="inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800">
              Cancel
            </a>
          </div>
        </form>
      </main>
    )}
  </main>
</Layout>

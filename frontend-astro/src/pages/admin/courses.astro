---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';

const API_URL = import.meta.env.PUBLIC_API_URL;

type Course = {
  id: number;
  title: string;
  instructor_name: string;
  price: string;
  is_frozen: boolean | number;
  thumbnail?: string;
};

let courses: Course[] = [];
let errorMessage = '';

// Handle actions like delete or freeze
if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        const courseId = formData.get('course_id');
        const action = formData.get('action');

        if (action === 'delete') {
            const response = await fetch(`${API_URL}/courses.php/${courseId}`, { method: 'DELETE' });
            if (!response.ok) throw new Error('Failed to delete course.');
        } else if (action === 'toggle_freeze') {
            // To toggle freeze, we send a POST request with the current state
            // The backend will handle the update logic
            const is_frozen = formData.get('is_frozen') === '1';
            const updateData = new FormData();
            updateData.append('_method', 'PUT');
            if (!is_frozen) {
                // We are freezing the course
                updateData.append('is_frozen', 'on');
            }
            // We need to send all fields, so we fetch the course data first
            const courseRes = await fetch(`${API_URL}/courses.php/${courseId}`);
            const courseData = await courseRes.json();
            const course = courseData.success && courseData.data ? courseData.data : courseData;
            for(const key in course) {
                if(key !== 'is_frozen' && updateData.get(key) === null) {
                    updateData.append(key, course[key]);
                }
            }

            const response = await fetch(`${API_URL}/courses.php/${courseId}`, {
                method: 'POST',
                body: updateData
            });
            if (!response.ok) throw new Error('Failed to toggle freeze state.');
        }
        return Astro.redirect('/admin/courses');
    } catch (error) {
        errorMessage = error.message;
    }
}

// Fetch all courses
try {
    const response = await fetch(`${API_URL}/courses.php`);
    if (!response.ok) {
        throw new Error("Failed to fetch courses from the API.");
    }
    const data = await response.json();
    // Handle standardized response format
    if (data.success && data.data) {
        courses = data.data;
    } else if (Array.isArray(data)) {
        courses = data;
    } else {
        throw new Error('Invalid response format');
    }
} catch (error) {
    errorMessage = error.message;
    courses = []; // Ensure courses is always an array
}
---

<Layout title="Manage Courses">
  <main class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold">Manage Courses</h1>
      <a href="/admin/add-course" class="bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded">
        Add New Course
      </a>
    </div>

    {errorMessage && <div class="mb-4 p-4 bg-red-100 border border-red-300 text-red-700 rounded">{errorMessage}</div>}

    <div class="bg-white shadow-md rounded-lg overflow-hidden">
      <table class="min-w-full leading-normal">
        <thead>
          <tr>
            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Course</th>
            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Instructor</th>
            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Price</th>
            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Status</th>
            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody>
          {courses.length > 0 ? courses.map((course) => (
            <tr>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                <div class="flex items-center">
                  {course.thumbnail && <img src={course.thumbnail} alt={course.title} class="w-16 h-16 object-cover rounded mr-4"/>}
                  <p class="text-gray-900 whitespace-no-wrap">{course.title}</p>
                </div>
              </td>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">{course.instructor_name}</td>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">${parseFloat(course.price).toFixed(2)}</td>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                <span class={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${!course.is_frozen ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'}`}>
                  {course.is_frozen ? 'Frozen' : 'Active'}
                </span>
              </td>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                <div class="flex items-center space-x-2">
                  <a href={`/admin/add-course?id=${course.id}`} class="text-blue-600 hover:text-blue-900">Edit</a>
                  <form class="delete-course-form" method="POST" onsubmit="return confirm('Are you sure you want to delete this course? This is irreversible.');">
                    <input type="hidden" name="course_id" value={course.id} />
                    <input type="hidden" name="action" value="delete" />
                    <button type="submit" class="text-red-600 hover:text-red-900">Delete</button>
                  </form>
                  <form class="toggle-freeze-form" method="POST">
                    <input type="hidden" name="course_id" value={course.id} />
                    <input type="hidden" name="action" value="toggle_freeze" />
                    <input type="hidden" name="is_frozen" value={course.is_frozen ? '1' : '0'} />
                    <button type="submit" class="text-yellow-600 hover:text-yellow-900">
                      {course.is_frozen ? 'Unfreeze' : 'Freeze'}
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          )) : (
            <tr>
              <td colspan="5" class="text-center py-10">No courses found. You can add one!</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </main>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const API_URL = import.meta.env.PUBLIC_API_URL;

    // Handle Delete Forms
    document.querySelectorAll('.delete-course-form').forEach(form => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!confirm('Are you sure you want to delete this course? This is irreversible.')) {
          return;
        }

        const formData = new FormData(form);
        const courseId = formData.get('course_id');

        const deleteData = new FormData();
        deleteData.append('course_id', courseId);
        deleteData.append('_method', 'DELETE');

        try {
          const response = await fetch(`${API_URL}/courses.php/${courseId}`, {
            method: 'POST',
            body: deleteData,
          });

          if (!response.ok) {
            const errorText = await response.text();
            throw new Error(`Failed to delete course: ${errorText}`);
          }
          window.location.reload();
        } catch (error) {
          alert(error.message);
          console.error('Error deleting course:', error);
        }
      });
    });

    // Handle Toggle Freeze Forms
    document.querySelectorAll('.toggle-freeze-form').forEach(form => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const formData = new FormData(form);
        const courseId = formData.get('course_id');
        const isFrozen = formData.get('is_frozen') === '1'; // Current state

        // Fetch current course data to send all fields for PUT request
        try {
          const courseRes = await fetch(`${API_URL}/courses.php/${courseId}`);
          if (!courseRes.ok) throw new Error('Failed to fetch course data for update.');
          const courseData = await courseRes.json();
          const course = courseData.success && courseData.data ? courseData.data : courseData;

          const updateData = new FormData();
          updateData.append('_method', 'PUT');
          if (!isFrozen) {
            // We are freezing the course
            updateData.append('is_frozen', 'on');
          }
          // If unfreezing, do NOT append is_frozen at all

          // Append all other fields required by the backend
          for(const key in course) {
            if(key !== 'is_frozen' && !updateData.has(key)) {
              updateData.append(key, course[key]);
            }
          }

          const response = await fetch(`${API_URL}/courses.php/${courseId}`, {
            method: 'POST', // Use POST for multipart/form-data with _method=PUT
            body: updateData,
          });

          if (!response.ok) {
            const errorText = await response.text();
            throw new Error(`Failed to toggle freeze state: ${errorText}`);
          }
          window.location.reload();
        } catch (error) {
          alert(error.message);
          console.error('Error toggling freeze state:', error);
        }
      });
    });
  });
</script> 
---
import Layout from '../../layouts/Layout.astro';
// TODO: Fetch and manage payment gateway parameters
let paymentGatewayParams = {
  apiKey: 'pk_test_YOUR_STRIPE_KEY',
  currency: 'USD',
  webhookSecret: 'whsec_YOUR_WEBHOOK_SECRET',
};

let paymentHistory = [
    {id: "1", student: "Alice Smith", course: "Course A", amount: "$49.99", date: "2024-07-28", status: "Paid"},
    {id: "2", student: "Bob Johnson", course: "Course B", amount: "$79.99", date: "2024-07-27", status: "Paid"},
];

// This is a client-side script example if you were to handle form submission
// For Astro, you'd typically handle this with API routes or server-side logic
---

<Layout title="Manage Payments">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-center mb-8">Manage Payment Gateway</h1>

    <div class="max-w-2xl mx-auto bg-white p-6 rounded-lg shadow-md mb-8">
      <h2 class="text-2xl font-semibold mb-4">Payment Gateway Parameters</h2>
      <form id="paymentParamsForm">
        <div class="mb-4">
          <label for="apiKey" class="block text-gray-700 text-sm font-bold mb-2">API Key:</label>
          <input type="text" id="apiKey" name="apiKey" value={paymentGatewayParams.apiKey} class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
        </div>
        <div class="mb-4">
          <label for="currency" class="block text-gray-700 text-sm font-bold mb-2">Currency:</label>
          <input type="text" id="currency" name="currency" value={paymentGatewayParams.currency} class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
        </div>
        <div class="mb-6">
          <label for="webhookSecret" class="block text-gray-700 text-sm font-bold mb-2">Webhook Secret:</label>
          <input type="text" id="webhookSecret" name="webhookSecret" value={paymentGatewayParams.webhookSecret} class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
        </div>
        <div class="flex items-center justify-between">
          <button class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" type="submit">
            Save Parameters
          </button>
        </div>
      </form>
    </div>

    <div class="bg-white shadow-md rounded-lg overflow-hidden">
        <h2 class="text-2xl font-semibold mb-4 p-5">Payment History</h2>
      <table class="min-w-full leading-normal">
        <thead>
          <tr>
            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Student</th>
            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Course</th>
            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Amount</th>
            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Date</th>
            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Status</th>
             <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody>
          {paymentHistory.map(payment => (
            <tr>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">{payment.student}</td>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">{payment.course}</td>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">{payment.amount}</td>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">{payment.date}</td>
               <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                <span class={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${payment.status === 'Paid' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`}>
                  {payment.status}
                </span>
              </td>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                <button class="text-blue-600 hover:text-blue-900">View Details</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </main>
</Layout>

<script>
  // Basic form submission handler (client-side, for demonstration)
  // In a real app, this would submit to an API endpoint.
  const form = document.getElementById('paymentParamsForm');
  if (form) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const formData = new FormData(event.target as HTMLFormElement);
      const params = Object.fromEntries(formData.entries());
      console.log('Saving payment parameters:', params);
      // Here you would typically make an API call to save the parameters
      alert('Parameters saved (mockup)!');
    });
  }
</script> 
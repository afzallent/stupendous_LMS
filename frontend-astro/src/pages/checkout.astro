---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Container from '../components/container.astro';
import { Icon } from 'astro-icon/components';
import { djangoApiServer, API_ENDPOINTS } from '../utils/django-api-server';

// Get course ID from query params
const courseId = Astro.url.searchParams.get('course_id');

if (!courseId) {
  return Astro.redirect('/courses');
}

// Fetch course details
let course = null;
try {
  const response = await djangoApiServer.get(API_ENDPOINTS.courses.detail(parseInt(courseId)));
  if (response.success) {
    course = response.data || response;
  }
} catch (e) {
  console.error('Error fetching course:', e);
}

if (!course) {
  return Astro.redirect('/courses');
}

const formatPrice = (price) => {
  const numPrice = parseFloat(price);
  return numPrice.toFixed(2);
};
---

<Layout title={`Checkout - ${course.title}`}>
  <Container>
    <div class="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
      
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-800 mb-2">Checkout</h1>
        <p class="text-gray-600">Complete your purchase to access the course</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Payment Form -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-800 mb-6">Payment Information</h2>
            
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
              <div class="flex items-start">
                <Icon name="mdi:information" class="w-5 h-5 text-yellow-600 mt-0.5 mr-2 flex-shrink-0" />
                <div>
                  <p class="text-sm text-yellow-800 font-medium">Payment Integration Coming Soon</p>
                  <p class="text-sm text-yellow-700 mt-1">
                    Payment processing with Stripe/PayPal will be integrated in the next phase. 
                    For now, this is a demonstration of the checkout flow.
                  </p>
                </div>
              </div>
            </div>

            <form id="payment-form" class="space-y-4">
              
              <!-- Card Number -->
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Card Number</label>
                <input 
                  type="text" 
                  placeholder="1234 5678 9012 3456"
                  class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  disabled
                />
              </div>

              <!-- Expiry and CVV -->
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Expiry Date</label>
                  <input 
                    type="text" 
                    placeholder="MM/YY"
                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    disabled
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">CVV</label>
                  <input 
                    type="text" 
                    placeholder="123"
                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    disabled
                  />
                </div>
              </div>

              <!-- Billing Info -->
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Cardholder Name</label>
                <input 
                  type="text" 
                  placeholder="John Doe"
                  class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  disabled
                />
              </div>

              <div class="pt-4">
                <button
                  type="button"
                  id="demo-enroll-btn"
                  data-course-id={course.id}
                  class="w-full px-6 py-3 bg-blue-600 text-white font-semibold rounded-md hover:bg-blue-700 transition-colors duration-150"
                >
                  Complete Purchase (Demo)
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- Order Summary -->
        <div class="lg:col-span-1">
          <div class="bg-white rounded-lg shadow-md p-6 sticky top-8">
            <h2 class="text-lg font-semibold text-gray-800 mb-4">Order Summary</h2>
            
            {course.thumbnail && (
              <img src={course.thumbnail} alt={course.title} class="w-full h-32 object-cover rounded-md mb-4" />
            )}
            
            <h3 class="font-medium text-gray-900 mb-2">{course.title}</h3>
            <p class="text-sm text-gray-600 mb-4">by {course.instructor.username}</p>
            
            <div class="border-t border-gray-200 pt-4 space-y-2">
              <div class="flex justify-between text-sm">
                <span class="text-gray-600">Course Price</span>
                <span class="font-medium">${formatPrice(course.price)}</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-600">Tax</span>
                <span class="font-medium">$0.00</span>
              </div>
              <div class="border-t border-gray-200 pt-2 mt-2">
                <div class="flex justify-between">
                  <span class="font-semibold text-gray-900">Total</span>
                  <span class="font-bold text-xl text-blue-600">${formatPrice(course.price)}</span>
                </div>
              </div>
            </div>

            <div class="mt-6 space-y-2 text-xs text-gray-500">
              <div class="flex items-center">
                <Icon name="mdi:shield-check" class="w-4 h-4 mr-2 text-green-500" />
                <span>Secure payment</span>
              </div>
              <div class="flex items-center">
                <Icon name="mdi:update" class="w-4 h-4 mr-2 text-green-500" />
                <span>Lifetime access</span>
              </div>
              <div class="flex items-center">
                <Icon name="mdi:certificate" class="w-4 h-4 mr-2 text-green-500" />
                <span>Certificate included</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</Layout>

<script>
  import { djangoApi, API_ENDPOINTS, TokenManager } from '../config/django-api.config';
  
  const demoEnrollBtn = document.getElementById('demo-enroll-btn');
  const courseId = demoEnrollBtn?.getAttribute('data-course-id');
  
  async function handleDemoEnrollment() {
    const user = TokenManager.getUser();
    if (!user) {
      alert('Please log in to continue');
      window.location.href = '/login/student';
      return;
    }
    
    demoEnrollBtn.disabled = true;
    demoEnrollBtn.textContent = 'Processing...';
    
    // Simulate payment processing
    await new Promise(resolve => setTimeout(resolve, 1500));
    
    // Enroll the user
    const response = await djangoApi.post(API_ENDPOINTS.enrollments.create, {
      course_id: parseInt(courseId)
    });
    
    if (response.success) {
      alert('Payment successful! You are now enrolled in the course.');
      window.location.href = `/course-player?course_id=${courseId}`;
    } else {
      demoEnrollBtn.disabled = false;
      demoEnrollBtn.textContent = 'Complete Purchase (Demo)';
      alert('Error: ' + (response.error || response.detail || 'Failed to enroll'));
    }
  }
  
  if (demoEnrollBtn) {
    demoEnrollBtn.addEventListener('click', handleDemoEnrollment);
  }
</script>
</Layout>

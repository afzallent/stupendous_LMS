---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import AssessmentCreator from '../../../../components/AssessmentCreator';
import ClerkProviderWrapper from '../../../../components/ClerkProviderWrapper.tsx';
---

<ClerkProviderWrapper>
<DashboardLayout title="Create New Assessment - CourseCompass LMS" userType="trainer">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Create New Assessment</h1>
    <a href="/dashboard/trainer/assessments" class="text-blue-600 hover:text-blue-800 flex items-center text-sm">
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      Back to Assessments
    </a>
  </div>
  
  <div class="bg-white shadow rounded-lg">
    <AssessmentCreator client:only="react" />
  </div>
</DashboardLayout>
</ClerkProviderWrapper>




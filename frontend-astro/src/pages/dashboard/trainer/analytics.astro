---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { Icon } from 'astro-icon/components';

export const prerender = false;

// Authentication is handled by middleware
---

<DashboardLayout title="Analytics - Trainer - CourseCompass LMS" userType="trainer">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Course Analytics</h1>
    <p class="text-gray-600">Track performance and engagement for your courses.</p>
  </div>

    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-semibold text-gray-700 mb-4">Analytics Overview (Placeholder)</h2>
      <p class="text-gray-500">Detailed charts and statistics will be displayed here, such as enrollment trends, completion rates, student engagement metrics, and revenue.</p>
      <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-4 border rounded-lg">
          <h3 class="font-semibold mb-2">Enrollment Trends</h3>
          <div class="h-64 bg-gray-200 flex items-center justify-center rounded">
            <Icon name="mdi:chart-line" class="w-12 h-12 text-gray-400" /> 
            <span class="ml-2 text-gray-500">Chart Placeholder</span>
          </div>
        </div>
        <div class="p-4 border rounded-lg">
          <h3 class="font-semibold mb-2">Completion Rates</h3>
          <div class="h-64 bg-gray-200 flex items-center justify-center rounded">
            <Icon name="mdi:chart-pie" class="w-12 h-12 text-gray-400" />
            <span class="ml-2 text-gray-500">Chart Placeholder</span>
          </div>
        </div>
      </div>
      <div class="mt-10 text-center">
          <Icon name="mdi:construction" class="w-16 h-16 text-yellow-500 mx-auto mb-4" />
          <h3 class="text-xl font-semibold text-gray-700">Analytics Page Under Construction</h3>
          <p class="text-gray-500">Check back soon for detailed insights!</p>
      </div>
    </div>
</DashboardLayout>


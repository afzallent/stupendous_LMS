---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import Icon from '../../../../components/Icon.astro';

// Set prerender to false since this is a dynamic page
export const prerender = false;

// Authentication is handled by middleware
// Courses will be loaded client-side with proper authentication
---

<DashboardLayout title="My Courses">
  <div class="space-y-6">
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">My Courses</h1>
        <p class="mt-1 text-sm text-gray-500">Manage your courses and lessons</p>
      </div>
      <a
        href="/dashboard/trainer/courses/new"
        class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
      >
        <Icon name="plus" class="h-5 w-5 mr-2" />
        Add New Course
      </a>
    </div>

    <!-- Course Grid -->
    <div id="coursesList" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Loading state -->
      <div class="col-span-full text-center py-12">
        <div class="mx-auto h-12 w-12 text-gray-400 animate-spin">
          <svg class="h-12 w-12" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </div>
        <h3 class="mt-2 text-sm font-medium text-gray-900">Loading courses...</h3>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  // Function to format date
  function formatDate(dateString) {
    const options = { year: 'numeric', month: 'long', day: 'numeric' };
    return new Date(dateString).toLocaleDateString(undefined, options);
  }

  // Function to format price
  function formatPrice(price) {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD'
    }).format(price);
  }

  // Function to get auth token
  function getAuthToken() {
    return localStorage.getItem('access_token') || localStorage.getItem('token');
  }

  // Function to get API base URL
  function getApiBaseUrl() {
    // In client-side scripts, we need to use window or hardcode the URL
    return 'http://localhost:8000/api';
  }

  // Function to load courses
  async function loadCourses() {
    const coursesList = document.getElementById('coursesList');
    
    try {
      const token = getAuthToken();
      if (!token) {
        throw new Error('No authentication token found');
      }

      const response = await fetch(`${getApiBaseUrl()}/courses/`, {
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        }
      });

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}: ${response.statusText}`);
      }

      const courses = await response.json();
      
      if (!Array.isArray(courses) || courses.length === 0) {
        coursesList.innerHTML = `
          <div class="col-span-full text-center py-12">
            <div class="mx-auto h-12 w-12 text-gray-400">
              <svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No courses</h3>
            <p class="mt-1 text-sm text-gray-500">Get started by creating a new course.</p>
            <div class="mt-6">
              <a
                href="/dashboard/trainer/courses/new"
                class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
              >
                <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Add New Course
              </a>
            </div>
          </div>
        `;
        return;
      }

      coursesList.innerHTML = courses.map(course => `
        <div class="bg-white overflow-hidden shadow rounded-lg">
          <div class="relative">
            <div class="aspect-w-16 aspect-h-9 bg-gray-200 h-48">
              <img
                src="${course.thumbnail || `https://placehold.co/400x200/e2e8f0/1e40af?text=${encodeURIComponent(course.title)}`}"
                alt="${course.title}"
                class="object-cover w-full h-full"
              />
            </div>
            <div class="absolute top-2 right-2">
              <button
                onclick="deleteCourse(${course.id})"
                class="p-1 rounded-full bg-white/80 hover:bg-white text-gray-600 hover:text-red-600 transition-colors"
                title="Delete course"
              >
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </div>
          </div>
          <div class="p-4">
            <h3 class="text-lg font-medium text-gray-900 truncate">${course.title}</h3>
            <p class="mt-1 text-sm text-gray-500 line-clamp-2">${course.description || 'No description'}</p>
            <div class="mt-4 flex items-center justify-between">
              <div class="flex items-center space-x-2">
                <span class="text-sm font-medium text-indigo-600">${formatPrice(course.price || 0)}</span>
                <span class="text-sm text-gray-500">•</span>
                <span class="text-sm text-gray-500">${course.lessons_count || 0} lessons</span>
              </div>
              <a
                href="/dashboard/trainer/courses/${course.id}/lessons"
                class="inline-flex items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded-md text-indigo-700 bg-indigo-100 hover:bg-indigo-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
              >
                Manage
              </a>
            </div>
          </div>
        </div>
      `).join('');
    } catch (error) {
      console.error('Error loading courses:', error);
      coursesList.innerHTML = `
        <div class="col-span-full text-center py-12">
          <div class="mx-auto h-12 w-12 text-red-500">
            <svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="mt-2 text-sm font-medium text-gray-900">Failed to load courses</h3>
          <p class="mt-1 text-sm text-gray-500">${error.message}</p>
          <div class="mt-6">
            <button
              onclick="loadCourses()"
              class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
            >
              Try Again
            </button>
          </div>
        </div>
      `;
    }
  }

  // Function to delete a course
  async function deleteCourse(courseId) {
    if (!confirm('Are you sure you want to delete this course? This action cannot be undone.')) {
      return;
    }

    try {
      const token = getAuthToken();
      if (!token) {
        throw new Error('No authentication token found');
      }

      const response = await fetch(`${getApiBaseUrl()}/courses/${courseId}/`, {
        method: 'DELETE',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        }
      });

      if (!response.ok) {
        throw new Error('Failed to delete course');
      }

      // Reload the courses list
      loadCourses();
    } catch (error) {
      console.error('Error deleting course:', error);
      alert('Failed to delete course. Please try again.');
    }
  }

  // Load courses when the page loads
  document.addEventListener('DOMContentLoaded', () => {
    loadCourses();
  });

  // Listen for Astro navigation events
  document.addEventListener('astro:page-load', () => {
    if (window.location.pathname === '/dashboard/trainer/courses') {
      loadCourses();
    }
  });
</script>



---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { Icon } from 'astro-icon/components';

export const prerender = false;
---

<DashboardLayout title="Student Dashboard - Stupendous LMS" userType="student">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Welcome back, <span id="user-name">Student</span>!</h1>
    <p class="text-gray-600">Here's an overview of your learning progress</p>
  </div>
  
  <!-- Stats Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-3 bg-blue-100 rounded-full">
          <Icon name="mdi:book-open-variant" class="w-6 h-6 text-blue-600" />
        </div>
        <div class="ml-4">
          <h3 class="text-lg font-semibold text-gray-700">Enrolled Courses</h3>
          <p class="text-2xl font-bold" id="total-courses">-</p>
        </div>
      </div>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-3 bg-green-100 rounded-full">
          <Icon name="mdi:check-circle" class="w-6 h-6 text-green-600" />
        </div>
        <div class="ml-4">
          <h3 class="text-lg font-semibold text-gray-700">Completed</h3>
          <p class="text-2xl font-bold" id="completed-courses">-</p>
        </div>
      </div>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-3 bg-yellow-100 rounded-full">
          <Icon name="mdi:clock" class="w-6 h-6 text-yellow-600" />
        </div>
        <div class="ml-4">
          <h3 class="text-lg font-semibold text-gray-700">In Progress</h3>
          <p class="text-2xl font-bold" id="in-progress-courses">-</p>
        </div>
      </div>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-3 bg-purple-100 rounded-full">
          <Icon name="mdi:certificate" class="w-6 h-6 text-purple-600" />
        </div>
        <div class="ml-4">
          <h3 class="text-lg font-semibold text-gray-700">Lessons Completed</h3>
          <p class="text-2xl font-bold" id="total-lessons">-</p>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Your Courses Section -->
  <div class="bg-white rounded-lg shadow p-6 mb-8">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-bold">Your Courses</h2>
      <a href="/courses" class="text-blue-600 hover:underline text-sm">Browse More Courses</a>
    </div>
    
    <div id="courses-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Loading state -->
      <div class="col-span-full text-center py-8">
        <p class="text-gray-500">Loading your courses...</p>
      </div>
    </div>
    
    <!-- Empty state template (hidden by default) -->
    <div id="empty-state" class="hidden text-center py-12">
      <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
      <p class="text-gray-600 mb-4">You haven't enrolled in any courses yet</p>
      <a href="/courses" class="inline-block px-6 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
        Browse Courses
      </a>
    </div>
  </div>
</DashboardLayout>

<script>
  import { djangoApi, API_ENDPOINTS, TokenManager } from '../../../config/django-api.config';
  
  async function loadDashboard() {
    try {
      // Get user info
      const user = TokenManager.getUser();
      if (user) {
        const userName = document.getElementById('user-name');
        if (userName) {
          userName.textContent = user.first_name || user.username;
        }
      }
      
      // Fetch dashboard data
      const response = await djangoApi.get(API_ENDPOINTS.dashboard.student);
      
      if (response.success) {
        // Update stats
        const totalCourses = document.getElementById('total-courses');
        const completedCourses = document.getElementById('completed-courses');
        const inProgressCourses = document.getElementById('in-progress-courses');
        const totalLessons = document.getElementById('total-lessons');
        
        if (totalCourses) totalCourses.textContent = response.total_courses?.toString() || '0';
        if (completedCourses) completedCourses.textContent = response.completed_courses?.toString() || '0';
        if (inProgressCourses) inProgressCourses.textContent = response.in_progress_courses?.toString() || '0';
        if (totalLessons) totalLessons.textContent = response.total_lessons_completed?.toString() || '0';
        
        // Load enrolled courses
        loadEnrolledCourses(response.enrolled_courses || []);
      } else {
        console.error('Failed to load dashboard:', response.error);
        if (response.error?.includes('Authentication') || response.error?.includes('credentials')) {
          TokenManager.clearTokens();
          window.location.href = '/login/student';
        }
      }
    } catch (error) {
      console.error('Error loading dashboard:', error);
    }
  }
  
  function loadEnrolledCourses(courses) {
    const container = document.getElementById('courses-container');
    const emptyState = document.getElementById('empty-state');
    
    if (!container) return;
    
    // Clear loading state
    container.innerHTML = '';
    
    if (!courses || courses.length === 0) {
      // Show empty state
      if (emptyState) {
        emptyState.classList.remove('hidden');
      }
      return;
    }
    
    // Hide empty state
    if (emptyState) {
      emptyState.classList.add('hidden');
    }
    
    // Render course cards
    courses.forEach(course => {
      const progressPercent = course.progress_percentage || 0;
      const isCompleted = progressPercent >= 100;
      const progressColor = isCompleted ? 'bg-green-600' : 'bg-blue-600';
      
      const card = document.createElement('div');
      card.className = 'border rounded-lg overflow-hidden hover:shadow-lg transition-shadow';
      card.innerHTML = `
        <div class="h-40 bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center">
          ${course.thumbnail ? 
            `<img src="${course.thumbnail}" alt="${course.title}" class="w-full h-full object-cover" />` :
            `<svg class="w-16 h-16 text-white opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>`
          }
        </div>
        
        <div class="p-4">
          <h3 class="font-bold mb-1 text-gray-800">${course.title}</h3>
          <p class="text-sm text-gray-600 mb-3">
            ${course.total_lessons || 0} lessons
            ${course.instructor ? ` • ${course.instructor}` : ''}
          </p>
          
          <div class="mb-3">
            <div class="flex items-center">
              <div class="w-full bg-gray-200 rounded-full h-2.5">
                <div class="${progressColor} h-2.5 rounded-full transition-all" style="width: ${progressPercent}%"></div>
              </div>
              <span class="ml-2 text-sm text-gray-600 font-medium">${progressPercent}%</span>
            </div>
          </div>
          
          ${isCompleted ? 
            `<a href="/courses/${course.id}" class="text-green-600 hover:underline text-sm font-medium">
              ✓ Completed - View Course
            </a>` :
            `<a href="/course-player?course_id=${course.id}" class="text-blue-600 hover:underline text-sm font-medium">
              Continue Learning →
            </a>`
          }
        </div>
      `;
      
      container.appendChild(card);
    });
  }
  
  // Load dashboard on page load
  document.addEventListener('astro:page-load', loadDashboard);
</script>

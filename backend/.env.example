# Database Configuration
# Copy this file to .env and fill in your actual credentials
# NEVER commit the .env file to version control!

DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=<coolify-postgres-internal-hostname>
DB_PORT=5432

# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,lms.5stars.dev

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://learn.5stars.dev

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual database credentials
# 3. Never commit the .env file
# 4. Keep credentials secure and rotate regularly
# 5. In Coolify, set these as environment variables in the UI

     $ref: \u0027#/components/schemas/PatchedLesson\u0027\n      security:\n      - jwtAuth: []\n      responses:\n        \u0027200\u0027:\n          content:\n            application/json:\n              schema:\n                $ref: \u0027#/components/schemas/Lesson\u0027\n          description: \u0027\u0027\n  /courses/api/progress/:\n    get:\n      operationId: courses_api_progress_list\n      description: ViewSet for progress tracking\n      parameters:\n      - name: page\n        required: false\n        in: query\n        description: A page number within the paginated result set.\n        schema:\n          type: integer\n      tags:\n      - courses\n      security:\n      - jwtAuth: []\n      responses:\n        \u0027200\u0027:\n          content:\n            application/json:\n              schema:\n                $ref: \u0027#/components/schemas/PaginatedProgressList\u0027\n          description: \u0027\u0027\n    post:\n      operationId: courses_api_progress_create\n      description: ViewSet for progress tracking\n      tags:\n      - courses\n      requestBody:\n        content:\n          application/json:\n            schema:\n              $ref: \u0027#/components/schemas/Progress\u0027\n          application/x-www-form-urlencoded:\n            schema:\n              $ref: \u0027#/components/schemas/Progress\u0027\n          multipart/form-data:\n            schema:\n              $ref: \u0027#/components/schemas/Progress\u0027\n        required: true\n      security:\n      - jwtAuth: []\n      responses:\n        \u0027201\u0027:\n          content:\n            application/json:\n              schema:\n                $ref: \u0027#/components/schemas/Progress\u0027\n          description: \u0027\u0027\n  /courses/api/progress/{id}/:\n    get:\n      operationId: courses_api_progress_retrieve\n      description: ViewSet for progress tracking\n      parameters:\n      - in: path\n        name: id\n        schema:\n          type: integer\n        description: A unique integer value identifying this progress.\n        required: true\n      tags:\n      - courses\n      security:\n      - jwtAuth: []\n      responses:\n        \u0027200\u0027:\n          content:\n            application/json:\n              schema:\n                $ref: \u0027#/components/schemas/Progress\u0027\n          description: \u0027\u0027\n    put:\n      operationId: courses_api_progress_update\n      description: ViewSet for progress tracking\n      parameters:\n      - in: path\n        name: id\n        schema:\n          type: integer\n        description: A unique integer value identifying this progress.\n        required: true\n      tags:\n      - courses\n      requestBody:\n        content:\n          application/json:\n            schema:\n              $ref: \u0027#/components/schemas/Progress\u0027\n          application/x-www-form-urlencoded:\n            schema:\n              $ref: \u0027#/components/schemas/Progress\u0027\n          multipart/form-data:\n            schema:\n              $ref: \u0027#/components/schemas/Progress\u0027\n        required: true\n      security:\n      - jwtAuth: []\n      responses:\n        \u0027200\u0027:\n          content:\n            application/json:\n              schema:\n                $ref: \u0027#/components/schemas/Progress\u0027\n          description: \u0027\u0027\n    patch:\n      operationId: courses_api_progress_partial_update\n      description: ViewSet for progress tracking\n      parameters:\n      - in: path\n        name: id\n        schema:\n          type: integer\n        description: A unique integer value identifying this progress.\n        required: true\n      tags:\n      - courses\n      requestBody:\n        content:\n          application/json:\n            schema:\n              $ref: \u0027#/components/schemas/PatchedProgress\u0027\n          application/x-www-form-urlencoded:\n            schema:\n              $ref: \u0027#/components/schemas/PatchedProgress\u0027\n          multipart/form-data:\n            schema:\n              $ref: \u0027#/components/schemas/PatchedProgress\u0027\n      security:\n      - jwtAuth: []\n      responses:\n        \u0027200\u0027:\n          content:\n            application/json:\n              schema:\n                $ref: \u0027#/components/schemas/Progress\u0027\n          description: \u0027\u0027\n    delete:\n      operationId: courses_api_progress_destroy\n      description: ViewSet for progress tracking\n      parameters:\n      - in: path\n        name: id\n        schema:\n          type: integer\n        description: A unique integer value identifying this progress.\n        required: true\n      tags:\n      - courses\n      security:\n      - jwtAuth: []\n      responses:\n        \u0027204\u0027:\n          description: No response body\n  /courses/api/progress/course_progress/:\n    get:\n      operationId: courses_api_progress_course_progress_retrieve\n      description: Get progress for a specific course\n      tags:\n      - courses\n      security:\n      - jwtAuth: []\n      responses:\n        \u0027200\u0027:\n          content:\n            application/json:\n              schema:\n                $ref: \u0027#/components/schemas/Progress\u0027\n          description: \u0027\u0027\n  /courses/api/progress/student_progress/:\n    get:\n      operationId: courses_api_progress_student_progress_retrieve\n      description: Get all students\u0027 progress for instructor\u0027s courses\n      tags:\n      - courses\n      security:\n      - jwtAuth: []\n      responses:\n        \u0027200\u0027:\n          content:\n            application/json:\n              schema:\n                $ref: \u0027#/components/schemas/Progress\u0027\n          description: \u0027\u0027\ncomponents:\n  schemas:\n    Category:\n      type: object\n      description: Serializer for course categories\n      properties:\n        id:\n          type: integer\n          readOnly: true\n        name:\n          type: string\n          maxLength: 100\n        slug:\n          type: string\n          maxLength: 100\n          pattern: ^[-a-zA-Z0-9_]+$\n        description:\n          type: string\n        course_count:\n          type: string\n          readOnly: true\n        created_at:\n          type: string\n          format: date-time\n          readOnly: true\n      required:\n      - course_count\n      - created_at\n      - id\n      - name\n      - slug\n    Certificate:\n      type: object\n      description: Serializer for certificates\n      properties:\n        id:\n          type: integer\n          readOnly: true\n        certificate_id:\n          type: string\n          format: uuid\n          readOnly: true\n        student:\n          type: integer\n          readOnly: true\n        course:\n          type: integer\n        issued_at:\n          type: string\n          format: date-time\n          readOnly: true\n        completion_date:\n          type: string\n          format: date\n          readOnly: true\n        student_name:\n          type: string\n          maxLength: 200\n        course_title:\n          type: string\n          maxLength: 200\n        instructor_name:\n          type: string\n          maxLength: 200\n        is_valid:\n          type: boolean\n          readOnly: true\n        verification_url:\n          type: string\n          readOnly: true\n      required:\n      - certificate_id\n      - completion_date\n      - course\n      - course_title\n      - id\n      - instructor_name\n      - is_valid\n      - issued_at\n      - student\n      - student_name\n      - verification_url\n    Course:\n      type: object\n      description: |-\n        Serializer for course data with nested instructor.\n\n        Provides course information including instructor details, lesson count, and enrollment count.\n      properties:\n        id:\n          type: integer\n          readOnly: true\n        title:\n          type: string\n          maxLength: 200\n        description:\n          type: string\n        instructor:\n          allOf:\n          - $ref: \u0027#/components/schemas/User\u0027\n          readOnly: true\n        category:\n          allOf:\n          - $ref: \u0027#/components/schemas/Category\u0027\n          readOnly: true\n        category_id:\n          type: integer\n          writeOnly: true\n          nullable: true\n        status:\n          $ref: \u0027#/components/schemas/StatusEnum\u0027\n        created_at:\n          type: string\n          format: date-time\n          readOnly: true\n        updated_at:\n          type: string\n          format: date-time\n          readOnly: true\n        published_at:\n          type: string\n          format: date-time\n          readOnly: true\n          nullable: true\n        lesson_count:\n          type: string\n          readOnly: true\n        enrolled_count:\n          type: string\n          readOnly: true\n        lessons:\n          type: array\n          items:\n            $ref: \u0027#/components/schemas/Lesson\u0027\n          readOnly: true\n      required:\n      - category\n      - created_at\n      - description\n      - enrolled_count\n      - id\n      - instructor\n      - lesson_count\n      - lessons\n      - published_at\n      - title\n      - updated_at\n    CourseDetail:\n      type: object\n      description: |-\n        Detailed serializer for course with all related data.\n\n        Includes enrollment status and progress percentage for the current user.\n      properties:\n        id:\n          type: integer\n          readOnly: true\n        title:\n          type: string\n          maxLength: 200\n        description:\n          type: string\n        instructor:\n          allOf:\n          - $ref: \u0027#/components/schemas/User\u0027\n          readOnly: true\n        category:\n          allOf:\n          - $ref: \u0027#/components/schemas/Category\u0027\n          readOnly: true\n        status:\n          $ref: \u0027#/components/schemas/StatusEnum\u0027\n        created_at:\n          type: string\n          format: date-time\n          readOnly: true\n        updated_at:\n          type: string\n          format: date-time\n          readOnly: true\n        published_at:\n          type: string\n          format: date-time\n          readOnly: true\n          nullable: true\n        lessons:\n          type: array\n          items:\n            $ref: \u0027#/components/schemas/Lesson\u0027\n          readOnly: true\n        is_enrolled:\n          type: string\n          readOnly: true\n        progress_percentage:\n          type: string\n          readOnly: true\n      required:\n      - category\n      - created_at\n      - description\n      - id\n      - instructor\n      - is_enrolled\n      - lessons\n      - progress_percentage\n      - published_at\n      - title\n      - updated_at\n    Enrollment:\n      type: object\n      description: |-\n        Serializer for enrollment with nested course data.\n\n        Represents a student\u0027s enrollment in a course with progress information.\n      properties:\n        id:\n          type: integer\n          readOnly: true\n        student:\n          type: integer\n          readOnly: true\n        course:\n          allOf:\n          - $ref: \u0027#/components/schemas/Course\u0027\n          readOnly: true\n        course_id:\n          type: integer\n          writeOnly: true\n        enrolled_at:\n          type: string\n          format: date-time\n          readOnly: true\n        progress_percentage:\n          type: string\n          readOnly: true\n      required:\n      - course\n      - course_id\n      - enrolled_at\n      - id\n      - progress_percentage\n      - student\n    FileTypeEnum:\n      enum:\n      - thumbnail\n      - video\n      - avatar\n      - document\n      - other\n      type: string\n      description: |-\n        * `thumbnail` - Thumbnail\n        * `video` - Video\n        * `avatar` - Avatar\n        * `document` - Document\n        * `other` - Other\n    Lesson:\n      type: object\n      description: |-\n        Serializer for lesson data.\n\n        Represents a lesson within a course, including video URL and content.\n      properties:\n        id:\n          type: integer\n          readOnly: true\n        course:\n          type: integer\n        title:\n          type: string\n          maxLength: 200\n        video_url:\n          type: string\n          format: uri\n          description: Enter the URL of the video (e.g. YouTube embed URL)\n          maxLength: 200\n        order:\n          type: integer\n          maximum: 9223372036854775807\n          minimum: 0\n          format: int64\n        content:\n          type: string\n          description: Additional notes or content\n      required:\n      - course\n      - id\n      - order\n      - title\n      - video_url\n    PaginatedCategoryList:\n      type: object\n      properties:\n        count:\n          type: integer\n          example: 123\n        next:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=4\n        previous:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=2\n        results:\n          type: array\n          items:\n            $ref: \u0027#/components/schemas/Category\u0027\n    PaginatedCertificateList:\n      type: object\n      properties:\n        count:\n          type: integer\n          example: 123\n        next:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=4\n        previous:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=2\n        results:\n          type: array\n          items:\n            $ref: \u0027#/components/schemas/Certificate\u0027\n    PaginatedCourseList:\n      type: object\n      properties:\n        count:\n          type: integer\n          example: 123\n        next:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=4\n        previous:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=2\n        results:\n          type: array\n          items:\n            $ref: \u0027#/components/schemas/Course\u0027\n    PaginatedEnrollmentList:\n      type: object\n      properties:\n        count:\n          type: integer\n          example: 123\n        next:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=4\n        previous:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=2\n        results:\n          type: array\n          items:\n            $ref: \u0027#/components/schemas/Enrollment\u0027\n    PaginatedLessonList:\n      type: object\n      properties:\n        count:\n          type: integer\n          example: 123\n        next:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=4\n        previous:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=2\n        results:\n          type: array\n          items:\n            $ref: \u0027#/components/schemas/Lesson\u0027\n    PaginatedProgressList:\n      type: object\n      properties:\n        count:\n          type: integer\n          example: 123\n        next:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=4\n        previous:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=2\n        results:\n          type: array\n          items:\n            $ref: \u0027#/components/schemas/Progress\u0027\n    PaginatedQuestionBankList:\n      type: object\n      properties:\n        count:\n          type: integer\n          example: 123\n        next:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=4\n        previous:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=2\n        results:\n          type: array\n          items:\n            $ref: \u0027#/components/schemas/QuestionBank\u0027\n    PaginatedQuestionList:\n      type: object\n      properties:\n        count:\n          type: integer\n          example: 123\n        next:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=4\n        previous:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=2\n        results:\n          type: array\n          items:\n            $ref: \u0027#/components/schemas/Question\u0027\n    PaginatedQuizList:\n      type: object\n      properties:\n        count:\n          type: integer\n          example: 123\n        next:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=4\n        previous:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=2\n        results:\n          type: array\n          items:\n            $ref: \u0027#/components/schemas/Quiz\u0027\n    PaginatedUploadedFileList:\n      type: object\n      properties:\n        count:\n          type: integer\n          example: 123\n        next:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=4\n        previous:\n          type: string\n          nullable: true\n          format: uri\n          example: http://api.example.org/accounts/?page=2\n        results:\n          type: array\n          items:\n            $ref: \u0027#/components/schemas/UploadedFile\u0027\n    PatchedCategory:\n      type: object\n      description: Serializer for course categories\n      properties:\n        id:\n          type: integer\n          readOnly: true\n        name:\n          type: string\n          maxLength: 100\n        slug:\n          type: string\n          maxLength: 100\n          pattern: ^[-a-zA-Z0-9_]+$\n        description:\n          type: string\n        course_count:\n          type: string\n          readOnly: true\n        created_at:\n          type: string\n          format: date-time\n          readOnly: true\n    PatchedCertificate:\n      type: object\n      description: Serializer for certificates\n      properties:\n        id:\n          type: integer\n          readOnly: true\n        certificate_id:\n          type: string\n          format: uuid\n          readOnly: true\n        student:\n          type: integer\n          readOnly: true\n        course:\n          type: integer\n        issued_at:\n          type: string\n          format: date-time\n          readOnly: true\n        completion_date:\n          type: string\n          format: date\n          readOnly: true\n        student_name:\n          type: string\n          maxLength: 200\n        course_title:\n          type: string\n          maxLength: 200\n        instructor_name:\n          type: string\n          maxLength: 200\n        is_valid:\n          type: boolean\n          readOnly: true\n        verification_url:\n          type: string\n          readOnly: true\n    PatchedCourse:\n      type: object\n      description: |-\n        Serializer for course data with nested instructor.\n\n        Provides course information including instructor details, lesson count, and enrollment count.\n      properties:\n        id:\n          type: integer\n          readOnly: true\n        title:\n          type: string\n          maxLength: 200\n        description:\n          type: string\n        instructor:\n          allOf:\n          - $ref: \u0027#/components/schemas/User\u0027\n          readOnly: true\n        category:\n          allOf:\n          - $ref: \u0027#/components/schemas/Category\u0027\n          readOnly: true\n        category_id:\n          type: integer\n          writeOnly: true\n          nullable: true\n        status:\n          $ref: \u0027#/components/schemas/StatusEnum\u0027\n        created_at:\n          type: string\n          format: date-time\n          readOnly: true\n        updated_at:\n          type: string\n          format: date-time\n          readOnly: true\n        published_at:\n          type: string\n          format: date-time\n          readOnly: true\n          nullable: true\n        lesson_count:\n          type: string\n          readOnly: true\n        enrolled_count:\n          type: string\n          readOnly: true\n        lessons:\n          type: array\n          items:\n            $ref: \u0027#/components/schemas/Lesson\u0027\n          readOnly: true\n    PatchedEnrollment:\n      type: object\n      description: |-\n        Serializer for enrollment with nested course data.\n\n        Represents a student\u0027s enrollment in a course with progress information.\n      properties:\n        id:\n          type: integer\n          readOnly: true\n        student:\n          type: integer\n          readOnly: true\n        course:\n          allOf:\n          - $ref: \u0027#/components/schemas/Course\u0027\n          readOnly: true\n        course_id:\n          type: integer\n          writeOnly: true\n        enrolled_at:\n          type: string\n          format: date-time\n          readOnly: true\n        progress_percentage:\n          type: string\n          readOnly: true\n    PatchedLesson:\n      type: object\n      description: |-\n        Serializer for lesson data.\n\n        Represents a lesson within a course, including video URL and content.\n      properties:\n        id:\n          type: integer\n          readOnly: true\n        course:\n          type: integer\n        title:\n          type: string\n          maxLength: 200\n        video_url:\n          type: string\n          format: uri\n          description: Enter the URL of the video (e.g. YouTube embed URL)\n          maxLength: 200\n        order:\n          type: integer\n          maximum: 9223372036854775807\n          minimum: 0\n          format: int64\n        content:\n          type: string\n          description: Additional notes or content\n    PatchedProgress:\n      type: object\n      description: |-\n        Serializer for progress tracking.\n\n        Tracks lesson completion status and timestamps for students.\n      properties:\n        id:\n          type: integer\n          readOnly: true\n        student:\n          type: integer\n          readOnly: true\n        lesson:\n          allOf:\n          - $ref: \u0027#/components/schemas/Lesson\u0027\n          readOnly: true\n        lesson_id:\n          type: integer\n          writeOnly: true\n        completed:\n          type: boolean\n        completed_at:\n          type: string\n          format: date-time\n          readOnly: true\n          nullable: true\n    PatchedQuestion:\n      type: object\n      description: Serializer for questions\n      properties:\n        id:\n          type: integer\n          readOnly: true\n        quiz:\n          type: integer\n          nullable: true\n        question_text:\n          type: string\n        question_type:\n          $ref: \u0027#/components/schemas/QuestionTypeEnum\u0027\n        points:\n          type: integer\n          maximum: 9223372036854775807\n          minimum: 1\n          format: int64\n        order:\n          type: integer\n          maximum: 9223372036854775807\n          minimum: 0\n          format: int64\n        explanation:\n          type: string\n          description: Explanation shown after answering\n        options:\n          type: array\n          items:\n            $ref: \u0027#/components/schemas/QuestionOption\u0027\n          readOnly: true\n        created_at:\n          type: string\n          format: date-time\n          readOnly: true\n    PatchedQuestionBank:\n      type: object\n      description: Serializer for question bank\n      properties:\n        id:\n          type: integer\n          readOnly: true\n        question_text:\n          type: string\n        question_type:\n          $ref: \u0027#/components/schemas/QuestionTypeEnum\u0027\n        points:\n          type: integer\n          maximum: 9223372036854775807\n          minimum: 1\n          format: int64\n        explanation:\n          type: string\n          description: Explanation shown after answering\n        options:\n          type: array\n          items:\n            $ref: \u0027#/components/schemas/QuestionOption\u0027\n          readOnly: true\n        course:\n          type: integer\n          nullable: true\n        is_in_bank:\n          type: boolean\n          description: True if in question bank, False if assigned to quiz\n        created_at:\n          type: string\n          format: date-time\n          readOnly: true\n    PatchedQuiz:\n      type: object\n      description: Serializer for quiz list\n      properties:\n        id:\n          type: integer\n          readOnly: true\n        course:\n          type: integer\n        lesson:\n          type: integer\n          nullable: true\n        title:\n          type: string\